<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BattleShip.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BattleShip.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BattleShip">
        
        <Grid>
                <!--MAIN MENU-->
                <StackPanel Name="MenuPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="300">
                        <TextBlock Text="BATTLE SHIP" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Button Name="FindMatchButton" Content="Find Match" Click="OnFindMatchClicked" HorizontalAlignment="Stretch" Padding="0,10"/>
                        <TextBlock Name="StatusText" Text="" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
                
                <!--GAME SCREEN-->
                <Grid Name="GamePanel" IsVisible="False" ColumnDefinitions="*,*" Margin="20">
                        <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Your Board" FontSize="18" HorizontalAlignment="Center"/>
                                <UniformGrid Name="YourGrid" Rows="10" Columns="10" Width="400" Height="400"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Enemy Board" FontSize="18" HorizontalAlignment="Center"/>
                                <UniformGrid Name="EnemyGrid" Rows="10" Columns="10" Width="400" Height="400"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                        <StackPanel Spacing="4">
                                                <TextBlock Text="Shot Type" HorizontalAlignment="Center"/>
                                                <ComboBox x:Name="ShotModeComboBox" SelectedIndex="0" Width="140">
                                                        <ComboBoxItem Content="Single Shot"/>
                                                        <ComboBoxItem Content="Line Shot"/>
                                                        <ComboBoxItem Content="Spread Shot"/>
                                                </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                                <TextBlock Text="Line Direction" HorizontalAlignment="Center"/>
                                                <ComboBox x:Name="LineOrientationComboBox" SelectedIndex="0" Width="140">
                                                        <ComboBoxItem Content="Horizontal"/>
                                                        <ComboBoxItem Content="Vertical"/>
                                                </ComboBox>
                                        </StackPanel>
                                </StackPanel>
                                <TextBlock Name="TurnText" Text="" HorizontalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                </Grid>
        </Grid>
</Window>
