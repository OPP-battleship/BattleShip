<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BattleShip.Client.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BattleShip.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BattleShip">
        
        <Grid>
                <!--MAIN MENU-->
                <StackPanel Name="MenuPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Width="300">
                        <TextBlock Text="BATTLE SHIP" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Button Name="FindMatchButton" Content="Find Match" Click="OnFindMatchClicked" HorizontalAlignment="Stretch" Padding="0,10"/>
                        <TextBlock Name="StatusText" Text="" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>

                <Grid Name="PlacementPanel" IsVisible="False" RowDefinitions="Auto,*" ColumnDefinitions="*,*" Margin="20">
                        <TextBlock Text="Place your fleet" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Your Board" FontSize="18" HorizontalAlignment="Center"/>
                                <Panel Name="PlacementGrid"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="12" HorizontalAlignment="Center">
                                <Panel Name="ShipSelectionGrid"/>
                                <TextBlock Name="PlacementStatusText" Text="" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                </Grid>
                
                <!--GAME SCREEN-->
                <Grid Name="GamePanel" IsVisible="False" RowDefinitions="Auto,*" ColumnDefinitions="*,*" Margin="20">
                        <Panel Name="ScoreboardGrid" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Your Board" FontSize="18" HorizontalAlignment="Center"/>
                                <Panel Name="YourGrid"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                <TextBlock Text="Enemy Board" FontSize="18" HorizontalAlignment="Center"/>
                                <Panel Name="EnemyGrid"/>
                                <Panel Name="ControlsGrid"/>
                                <TextBlock Name="TurnText" Text="" HorizontalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                </Grid>
        </Grid>
</Window>
